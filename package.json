{
  "name": "perihub-frontend",
  "version": "4.0.0",
  "description": "Frontend for PeriHub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "prepare": "svelte-kit sync || echo '' && husky",
    "client": "openapi-ts --input http://localhost:8000/openapi.json --output ./src/lib/client --client axios --base http://localhost:8000"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hey-api/openapi-ts": "^0.51.0",
    "@playwright/test": "^1.54.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.5.9",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.2.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.15.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@threlte/core": "^8.6.0",
    "@threlte/extras": "^9.21.1",
    "axios": "^1.6.8",
    "bibtex-parse-js": "^0.0.23",
    "bits-ui": "^1.0.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^0.9.8",
    "js-sha256": "^0.11.0",
    "jwt-decode": "^4.0.0",
    "keycloak-js": "^26.2.4",
    "layerchart": "^1.0.0",
    "lucide-svelte": "^0.469.0",
    "mathjs": "^11.9.1",
    "medium-zoom": "^1.1.0",
    "mitt": "^3.0.1",
    "prismjs": "^1.30.0",
    "svelte-jsoneditor": "^3.10.0",
    "svelte-sonner": "^0.3.28",
    "sveltekit-i18n": "^2.4.2",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1",
    "three": "^0.186.0",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix"
    ],
    "*.{js,ts,svelte,css,md,json}": [
      "prettier --write"
    ]
  }
}
