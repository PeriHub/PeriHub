# TRIAL=FALSE
# VOLUME=PATH_TO_YOUR_JOB_FOLDER
# RSA_VOLUME=PATH_TO_YOUR_RSA_FILES
# MAX_NODES=10000
#
# This, CLUSTER_URL, and the OAUTH_* settings below are read by both the
# backend and the frontend (via GET /config/public) - set them here once,
# not separately for each container.

# Here you can mount your own models.
# OWN_MODELS=PATH_TO_YOUR_MODEL

# If you installed PeriLab on a ssh server, you can use the following settings.
# CLUSTER_URL=URL
# CLUSTER_USER=USER
# CLUSTER_JOB_PATH=PATH_TO_YOUR_JOB_FOLDER
# CLUSTER_PERILAB_PATH=PATH_TO_PERILAB
# CLUSTER_PASSWORD=PASSWORD

# You can log users in via any OAuth2/OIDC identity provider - a
# self-hosted Keycloak realm, Auth0, Azure AD, Okta, etc.
# (Enterprise only - requires a valid LICENSE_KEY, see below.)
# For Keycloak, OAUTH_DISCOVERY_URL is
# https://keycloak.HOST.de/realms/YOUR_REALM/.well-known/openid-configuration
# OAUTH_DISCOVERY_URL = https://your-idp.example.com/.well-known/openid-configuration
# OAUTH_CLIENT_ID = perihub
# OAUTH_CLIENT_SECRET = CHANGE_ME
# OAUTH_REDIRECT_URI = https://your-perihub-host.example.com/auth/callback

# --- Multi-user database (Phase 0) -------------------------------------
# Required for community/enterprise: accounts, org settings, and (later)
# shared model configs/materials. Trial mode works without it.
# DATABASE_URL=postgresql+psycopg://perihub:CHANGE_ME@localhost:5432/perihub

# Signing secret for local email/password session tokens. Generate with
# e.g. `openssl rand -hex 32` - required for local auth to work.
# SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# SESSION_TTL_SECONDS=604800

# "trial" | "community" | "enterprise" - defaults to "trial" if TRIAL=True,
# otherwise "community".
# DEPLOYMENT_MODE=community

# --- License server (required to unlock enterprise features) -----------
# OAuth2/OIDC login, and seat enforcement, only activate with a valid
# license. See support/license_client.py and support/entitlements.py.
# LICENSE_SERVER_URL=https://license.your-domain.com
# LICENSE_KEY=CHANGE_ME
# LICENSE_INSTANCE_ID=CHANGE_ME