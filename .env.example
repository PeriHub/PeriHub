# --- Required ---
# Host is perihub_db in docker compose, localhost for `fastapi dev`; the password must match POSTGRES_PASSWORD.
# DATABASE_URL=postgresql+psycopg://perihub:CHANGE_ME@perihub_db:5432/perihub
# POSTGRES_PASSWORD=CHANGE_ME
# Generate with `openssl rand -hex 32`.
# SESSION_SECRET=CHANGE_ME

# --- Optional ---
# PeriLab API as seen from the backend (default http://localhost:3000, for `fastapi dev`).
# LOCAL_PERILAB_API_URL=http://perilab:3000
# GUEST_ACCESS=False
# VOLUME=./backend/app/simulations
# OWN_MODELS=./backend/app/own_models

# --- Enterprise (needs a license) ---
# DEPLOYMENT_MODE=enterprise
# LICENSE_SERVER_URL=https://license.example.com
# LICENSE_KEY=CHANGE_ME
# CONTENT_SIGNING_SECRET=CHANGE_ME
# LICENSE_INSTANCE_ID=CHANGE_ME
# OAuth2/OIDC login (Keycloak: https://HOST/realms/REALM/.well-known/openid-configuration).
# OAUTH_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# OAUTH_CLIENT_ID=perihub
# OAUTH_CLIENT_SECRET=CHANGE_ME
# OAUTH_REDIRECT_URI=https://perihub.example.com/auth/callback
# Forgot-password emails via an existing SMTP server (hidden when SMTP_HOST is unset).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=perihub@example.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=PeriHub <perihub@example.com>
# SMTP_SECURITY=starttls   # starttls | ssl | none
# Address users reach PeriHub at; reset links point here.
# PUBLIC_URL=https://perihub.example.com
