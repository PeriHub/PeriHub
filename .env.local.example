# Local dev overrides for `npm run dev` (Vite). Copy to `.env.local`.
# In production these are instead injected at container startup — see entrypoint.sh — from
# the values in `.env` (see .env.example), so you normally don't need this file outside local dev.

# VITE_TRIAL=True
# VITE_CLUSTER_URL=
# VITE_KEYCLOAK_URL=
# VITE_REALM=
# VITE_CLIENT_ID=
